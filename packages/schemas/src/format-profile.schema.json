{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-channel-design.local/schemas/format-profile.schema.json",
  "title": "Format Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "format", "canvas", "criticalZone", "logoSafeZone", "previews", "sources", "lastVerifiedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "format": { "enum": ["POST_PORTRAIT", "POST_SQUARE", "CAROUSEL", "STORY", "REELS_COVER"] },
    "canvas": { "$ref": "#/$defs/dimensions" },
    "criticalZone": { "$ref": "#/$defs/rect" },
    "logoSafeZone": { "$ref": "#/$defs/rect" },
    "previews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "crop"],
        "properties": {
          "kind": { "enum": ["FULL", "FEED", "PROFILE_GRID", "STORY_UI", "REELS_UI"] },
          "crop": { "$ref": "#/$defs/rect" },
          "exclusions": { "type": "array", "items": { "$ref": "#/$defs/rect" } }
        }
      }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
    "lastVerifiedAt": { "type": "string", "format": "date" }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
