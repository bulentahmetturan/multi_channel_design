{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-channel-design.local/schemas/logo-manifest.schema.json",
  "title": "Logo Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channelId", "version", "status", "assetPrefix", "expectedCount", "assets"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "channelId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["COLLECTING", "VALIDATING", "PASS"] },
    "assetPrefix": { "type": "string", "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$" },
    "expectedCount": { "const": 12 },
    "assets": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "form", "treatment", "expectedFilename", "status"],
        "properties": {
          "slot": { "type": "integer", "minimum": 1, "maximum": 12 },
          "form": { "enum": ["CIRCULAR", "HORIZONTAL", "ICON_ONLY", "VERTICAL"] },
          "treatment": { "enum": ["ORIGINAL", "WHITE", "BLACK"] },
          "expectedFilename": { "type": "string", "pattern": "^[a-z0-9_-]+\\.png$" },
          "status": { "enum": ["PENDING", "NEEDS_CORRECTION", "PASS"] },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "hasAlpha": { "type": "boolean" },
              "isOpaque": { "type": "boolean" },
              "embeddedCheckerboard": { "type": "boolean" },
              "result": { "enum": ["PASS", "NEEDS_CORRECTION"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
