{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-channel-design.local/schemas/hekimler-source-policy-map.schema.json",
  "title": "Hekimler Topluluğu Source Policy Map",
  "description": "Declarative per-source routing and evidence controls for tip-ogrencileri-platformu (editorial brand: Hekimler Topluluğu). Authority or virality alone must never decide publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channelId",
    "editorialBrand",
    "audience",
    "routes",
    "globalRules",
    "sourcePolicies",
    "candidateDecisionContract",
    "aiBounds"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "channelId": { "const": "tip-ogrencileri-platformu" },
    "editorialBrand": { "type": "string", "minLength": 1 },
    "policyId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "approvalStatus": {
      "enum": ["DRAFT", "USER_APPROVED", "SUPERSEDED"]
    },
    "approvedAt": { "type": "string" },
    "purpose": { "type": "string", "minLength": 1 },
    "notInScope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segments", "primary", "nonPrimary"],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {
                "enum": [
                  "medical_student",
                  "intern",
                  "resident",
                  "early_career_physician",
                  "physician",
                  "academic_physician"
                ]
              },
              "label": { "type": "string", "minLength": 1 },
              "notes": { "type": "string" }
            }
          }
        },
        "primary": {
          "type": "array",
          "items": {
            "enum": [
              "medical_student",
              "intern",
              "resident",
              "early_career_physician",
              "physician",
              "academic_physician"
            ]
          },
          "minItems": 1
        },
        "nonPrimary": {
          "type": "array",
          "items": {
            "enum": [
              "medical_student",
              "intern",
              "resident",
              "early_career_physician",
              "physician",
              "academic_physician"
            ]
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose"],
        "properties": {
          "id": {
            "enum": [
              "FEED",
              "PROFESSIONAL_BRIEF",
              "OPPORTUNITY",
              "CONGRESS_CALENDAR",
              "ABROAD_CAREER",
              "TREND_INBOX",
              "DISCARD"
            ]
          },
          "purpose": { "type": "string", "minLength": 1 },
          "viralityMayReducePriority": { "type": "boolean" }
        }
      }
    },
    "globalRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neverAuthorityAlone",
        "neverViralityAlone",
        "noInventedEvidence",
        "aiRole"
      ],
      "properties": {
        "neverAuthorityAlone": { "type": "string", "minLength": 1 },
        "neverViralityAlone": { "type": "string", "minLength": 1 },
        "noInventedEvidence": { "type": "string", "minLength": 1 },
        "aiRole": { "type": "string", "minLength": 1 },
        "lifeCultureColumn": { "type": "string" },
        "facultyAndCuratorRole": { "type": "string" }
      }
    },
    "sourcePolicies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourcePolicy" }
    },
    "candidateDecisionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFields", "evidenceStatuses", "riskFlags"],
      "properties": {
        "requiredFields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceStatuses": {
          "type": "array",
          "items": {
            "enum": ["verified", "needs-check", "discovery-only", "insufficient"]
          }
        },
        "riskFlags": {
          "type": "array",
          "items": {
            "enum": [
              "patient_privacy",
              "named_institution_allegation",
              "medical_claim",
              "advertising_sensitivity",
              "organisation_advocacy",
              "preprint",
              "consumer_media",
              "copyright_reference_account",
              "gulf_watch_only"
            ]
          }
        }
      }
    },
    "aiBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may", "mustNot"],
      "properties": {
        "may": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "mustNot": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "designIndependence": { "type": "string" },
    "$comment": { "type": "string" }
  },
  "$defs": {
    "keywordList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "source_role",
        "audience_segments",
        "include_keywords",
        "exclude_keywords",
        "allowed_routes",
        "required_evidence",
        "required_transform",
        "score_boosts",
        "score_penalties",
        "commercial_sensitivity",
        "primary_url_required",
        "rules"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "matchesSourceIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Optional glue to official_sources.yaml / Hub ids"
        },
        "source_tier": {
          "enum": ["primary", "professional", "scientific", "discovery", "opportunity", "abroad"]
        },
        "source_role": {
          "enum": [
            "primary_official",
            "professional_org",
            "scientific_evidence",
            "discovery_media",
            "faculty_opportunity",
            "club_curator",
            "congress_organizer",
            "abroad_regulator",
            "trend_signal"
          ]
        },
        "audience_segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "medical_student",
              "intern",
              "resident",
              "early_career_physician",
              "physician",
              "academic_physician"
            ]
          }
        },
        "include_keywords": { "$ref": "#/$defs/keywordList" },
        "exclude_keywords": { "$ref": "#/$defs/keywordList" },
        "allowed_routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "FEED",
              "PROFESSIONAL_BRIEF",
              "OPPORTUNITY",
              "CONGRESS_CALENDAR",
              "ABROAD_CAREER",
              "TREND_INBOX",
              "DISCARD"
            ]
          }
        },
        "default_route": {
          "enum": [
            "FEED",
            "PROFESSIONAL_BRIEF",
            "OPPORTUNITY",
            "CONGRESS_CALENDAR",
            "ABROAD_CAREER",
            "TREND_INBOX",
            "DISCARD"
          ]
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_transform": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "impact_card",
              "legal_impact_card",
              "organisation_position_label",
              "study_card",
              "opportunity_card",
              "congress_card",
              "abroad_checklist",
              "trend_triple_url",
              "none_discard"
            ]
          }
        },
        "score_boosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "effect"],
            "properties": {
              "when": { "type": "string", "minLength": 1 },
              "effect": { "type": "string", "minLength": 1 }
            }
          }
        },
        "score_penalties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "effect"],
            "properties": {
              "when": { "type": "string", "minLength": 1 },
              "effect": { "type": "string", "minLength": 1 }
            }
          }
        },
        "commercial_sensitivity": {
          "enum": ["none", "low", "medium", "high", "prohibited_as_primary"]
        },
        "primary_url_required": { "type": "boolean" },
        "discovery_only": { "type": "boolean" },
        "viralityMustNotReduceOpportunity": { "type": "boolean" },
        "watch_only_v1": { "type": "boolean" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
