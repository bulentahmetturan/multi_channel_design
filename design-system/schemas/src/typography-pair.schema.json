{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-channel-design.local/schemas/typography-pair.schema.json",
  "title": "Typography Pair",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "channelId", "headlineFamily", "bodyFamily", "roles", "scores", "turkishGlyphsPass"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "channelId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "headlineFamily": { "type": "string", "minLength": 1 },
    "bodyFamily": { "type": "string", "minLength": 1 },
    "accentFamily": { "type": "string", "minLength": 1 },
    "accentJustification": { "type": "string", "minLength": 1 },
    "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["HEADLINE", "BODY", "EDITORIAL", "STATISTICS", "CAPTION"] } },
    "scores": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
      "required": ["readability", "tone", "densityFit", "capacityFit"]
    },
    "turkishGlyphsPass": { "const": true }
  },
  "allOf": [
    {
      "if": { "required": ["accentFamily"] },
      "then": { "required": ["accentJustification"] }
    }
  ]
}
